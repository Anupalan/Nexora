# Example only. Use secret injection in production; never commit real values.
APP_ENV=development
APP_NAME=Nexora
PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
REDIS_URL=redis://localhost:6379/0

# Set false only for plain-http local development.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Web -> API proxy target (Next.js rewrites)
API_INTERNAL_URL=http://localhost:8001

# LiteLLM gateway (private network). The master key must never reach browsers or developers.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=change-me

# Scheduler and quotas (see README, Phase 3). Start conservatively; benchmark before raising.
DEFAULT_MAX_ACTIVE_REQUESTS=2
DEFAULT_MAX_QUEUE_LENGTH=100
QUEUE_TIMEOUT_SECONDS=300

# Operations (health checks, alerts, metrics). /metrics returns 404 until METRICS_TOKEN is set.
HEALTH_CHECK_INTERVAL_SECONDS=30
ALERT_QUEUE_DEPTH=20
ALERT_QUEUE_WAIT_MS=30000
ALERT_QUOTA_PERCENT=90
ALERT_AUTH_FAILURES=10
METRICS_TOKEN=
